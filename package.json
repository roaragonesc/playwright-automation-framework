{
    "name": "playwright-automation-framework",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "test": "playwright test",
        "test:ui": "playwright test --project=ui-chrome --project=ui-edge",
        "test:api": "playwright test --project=api",
        "test:headed": "playwright test --project=ui-chrome --project=ui-edge --headed",
        "test:report": "playwright show-report",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@playwright/test": "^1.56.0",
        "@types/node": "^22.0.0",
        "dotenv": "^16.4.5",
        "playwright-qase-reporter": "^2.7.0",
        "typescript": "^5.7.0"
    }
}