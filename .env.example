UI_BASE_URL=https://automationexercise.com
API_BASE_URL=https://automationexercise.com

# Replace these placeholders with an existing registered test account.
E2E_TEST_USER_EMAIL=REPLACE_WITH_REGISTERED_TEST_EMAIL
E2E_TEST_USER_PASSWORD=REPLACE_WITH_REGISTERED_TEST_PASSWORD

# Optional for local Qase result upload. Never commit a real token.
QASE_MODE=testops
QASE_TESTOPS_PROJECT=AEQA
QASE_TESTOPS_API_TOKEN=REPLACE_WITH_QASE_API_TOKEN
